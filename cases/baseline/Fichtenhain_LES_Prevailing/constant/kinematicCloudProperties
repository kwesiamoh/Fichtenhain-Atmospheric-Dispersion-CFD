FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      kinematicCloudProperties;
}

solution
{
    active          false;
    coupled         false;
    transient       yes;

    cellValueSourceCorrection off;

    interpolationSchemes
    {
        rho.air     cell;
        U.air       cellPoint;
        mu.air      cell;
    }

    integrationSchemes
    {
        U           Euler;
    }

    sourceTerms
    {
        schemes
        {
            U semiImplicit 1;
        }
    }
}

constantProperties
{
    parcelTypeId       1;

    rhoMin             1e-15;
    minParcelMass      1e-15;

    rho0               1.225;

    constantVolume     false;

    alphaMax           0.001;
}

subModels
{
    particleForces
    {
        sphereDrag;
    }

    injectionModels
    {
    }

    dispersionModel none;

    patchInteractionModel none;

    surfaceFilmModel none;

    collisionModel none;

    stochasticCollisionModel none;
}

cloudFunctions
{
}

