// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          controlDict;
}

application     DPMFoam;

startFrom       latestTime;

startTime       1660;

stopAt          endTime;

endTime         1850;

deltaT          0.0001;

writeControl    runTime;

writeInterval   5;

purgeWrite      0;

writeFormat     binary;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   17;

runTimeModifiable true;

adjustTimeStep  yes;

maxCo           0.5;

maxDeltaT       0.05;

libs            ( "libatmosphericModels.so" );


